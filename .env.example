# ==============================================================================
# NECKLINK — Environment Variables Configuration Template
# ==============================================================================

# Core Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:1912@localhost:5432/necklink
POSTGRES_PASSWORD=1912

# Services Network Ports
PORT=5000
ML_SERVICE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://localhost:5000

# OpenWeatherMap API (Precipitation & Meteorological feeds)
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE

# Government of India Bhashini ULCA Translation Pipeline
BHASHINI_USER_ID=YOUR_BHASHINI_USER_ID_HERE
BHASHINI_API_KEY=YOUR_BHASHINI_API_KEY_HERE
GOOGLE_TRANSLATE_API_KEY=YOUR_GOOGLE_TRANSLATE_KEY_FALLBACK_HERE

# Twilio SMS Telecommunications Sandbox
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_FROM_NUMBER=YOUR_TWILIO_FROM_NUMBER_HERE

# Firebase Cloud Messaging & Realtime DB Configuration
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN_HERE
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID_HERE
FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET_HERE
FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID_HERE
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID_HERE
FIREBASE_DATABASE_URL=YOUR_FIREBASE_DATABASE_URL_HERE
