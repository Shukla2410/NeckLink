# Local demo defaults. Never expose demo mode publicly.
APP_MODE=demo
HOST=127.0.0.1
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/necklink
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/necklink_test
ML_SERVICE_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://127.0.0.1:5000
TRUST_PROXY=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional integrations. Empty values intentionally mean unavailable.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
OPENWEATHER_API_KEY=
ENABLE_WEATHER_INGESTION=false

# Keep delivery disabled until recipients and credentials are verified.
DISABLE_EXTERNAL_DELIVERY=true
ENABLE_SMS_DELIVERY=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional legacy mirror, not needed for SSE live updates.
FIREBASE_DATABASE_URL=
FIREBASE_DATABASE_SECRET=
